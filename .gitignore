# ========================================
# MOVIESEARCH APP - .gitignore
# ========================================

# ========================================
# Environment Variables (CRITICAL - DON'T COMMIT)
# ========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.example  # Only if it contains real keys

# ========================================
# Dependencies
# ========================================
/node_modules
/node_modules/*
!node_modules/.gitkeep

# Package lock files (optional - include if you prefer)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ========================================
# Build Outputs
# ========================================
/dist
/build
/.next
/out
/.output
/.vercel
/.netlify

# ========================================
# Testing
# ========================================
/coverage
*.lcov
.nyc_output
/test-results
/vitest-results

# ========================================
# Logs
# ========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite-debug.log*

# ========================================
# OS Files
# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ========================================
# IDE / Editor Files
# ========================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ========================================
# TypeScript
# ========================================
*.tsbuildinfo
*.ts.map
*.js.map

# ========================================
# Cache
# ========================================
.cache
.parcel-cache
.turbo
.eslintcache
.prettiercache
.vitest-cache

# ========================================
# Temporary Files
# ========================================
*.tmp
*.temp
*.bak
*.backup
*.old

# ========================================
# Project Specific
# ========================================
# Sentry
.sentryclirc

# Firebase
.firebase

# Cypress
cypress/videos/
cypress/screenshots/

# Storybook
storybook-static

# ========================================
# GitHub Pages
# ========================================
*.html.bak

# ========================================
# Optional: API Keys & Secrets
# ========================================
*.pem
*.key
*.crt
*.p12
*.pfx

# ========================================
# Docker
# ========================================
.dockerignore
Dockerfile*
docker-compose*.yml
*.dockerfile

# ========================================
# Miscellaneous
# ========================================
*.pkg
*.dmg
*.exe
*.msi
*.deb
*.rpm